; Engine configuration file.
config_version=5

[application]

config/name="Timeless Journeys"
config/description="Timeless Journeys: The Italian Grand Tour, versione digitale."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.13, 0.1, 0.08, 1)
boot_splash/show_image=false

[debug]

gdscript/warnings/redundant_await=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/incompatible_ternary=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
